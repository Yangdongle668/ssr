# SSR Docker 一键部署配置文件
# 复制为 .env 后修改：cp .env.example .env

# ===== SSR 服务参数 =====
SSR_PORT=17777
SSR_PASSWORD=gugugu
SSR_METHOD=chacha20-ietf
SSR_PROTOCOL=auth_chain_a
SSR_OBFS=tls1.2_ticket_auth
SSR_OBFS_PARAM=cloud.tencent.com

# ===== 网络加速 =====
# BBR 模式: bbrplus(推荐) | bbr(原版,需内核>=4.9) | auto(自动检测最优) | skip(跳过)
ACCEL_MODE=auto

# 是否应用 sysctl 网络调优(TCP fastopen / 缓冲区 / MTU 探测等)
ENABLE_SYSCTL_TUNE=true

# ===== 防火墙 =====
# 自动配置 iptables/firewalld/ufw 放行 SSR 端口
ENABLE_FIREWALL=true

# ===== 可选附加项 =====
# fail2ban 防 SSH 爆破(独立于 SSR,但 VPS 安全推荐)
ENABLE_FAIL2BAN=false

# 生成 QR 码(终端显示 + 保存 PNG 到当前目录)
ENABLE_QRCODE=true

# ===== 高级 =====
# 强制 IP(不指定则自动检测公网 IP)
SSR_SERVER_IP=

# 节点备注名(显示在 SSR 客户端列表中)
SSR_REMARK=My-SSR-Node
